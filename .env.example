# Runtime: copy the Neon connection string with Connection pooling enabled.
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=5&pool_timeout=20"
# Migrations/import: same database and branch, Connection pooling disabled.
DIRECT_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Exact canonical origin for this environment
APP_ORIGIN="http://localhost:3000"
# Used by password recovery and optional email verification (verified sender)
RESEND_API_KEY=""
EMAIL_FROM=""
# Resend webhook signing secret for /api/webhooks/resend (whsec_...)
RESEND_WEBHOOK_SECRET=""
