generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  emailVerifiedAt DateTime?
  sessions     Session[]
  progress     TaskProgress[]
  answers      AnswerAttempt[]
  achievementShares AchievementShare[]
}

model AchievementShare {
  token     String   @id @default(uuid())
  userId    String
  worldId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
}

model TaskProgress {
  id          String          @id
  userId      String
  taskId      String
  worldId     String
  completed   Boolean         @default(false)
  completedAt DateTime?
  acertos     Int             @default(0)
  erros       Int             @default(0)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     AnswerAttempt[]

  @@unique([userId, taskId])
  @@index([userId])
}

model AnswerAttempt {
  id             String       @id
  userId         String
  taskProgressId String
  taskId         String
  questionId     String
  selectedIndex  Int
  correctIndex   Int
  isCorrect      Boolean
  answeredAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskProgress   TaskProgress @relation(fields: [taskProgressId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
  @@index([taskProgressId])
  @@unique([taskProgressId, questionId])
}

model Session {
  tokenHash String @id
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AuthChallenge {
  tokenHash String @id
  email String
  kind String
  name String?
  passwordHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  subjectUserId String?
  deliveryId String @unique @default(uuid())
  providerId String? @unique
  deliveryStatus String @default("accepted")
  @@index([email, kind])
  @@index([expiresAt])
}

// Historical duplicate rows retained by the security migration, never queried by APIs.
model AnswerArchive {
  id String @id
  record Json
  archivedAt DateTime @default(now())
}
